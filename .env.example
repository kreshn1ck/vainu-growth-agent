# Run immediately without external credentials
USE_MOCK_VAINU=true
SCORER_MODE=rules

# Real Vainu API
VAINU_REFRESH_TOKEN=
VAINU_BASE_URL=https://api.vainu.io/api/v3
VAINU_TOKEN_URL=https://api.vainu.io/api/token_authentication/refresh/

# Optional AWS Bedrock scoring
AWS_REGION=eu-north-1
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-20250514-v1:0
